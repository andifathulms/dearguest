{
  "id": "betawi",
  "layoutVariant": "painted",
  "hero": "framed",
  "gallery": "editorial",
  "opening": {
    "type": "css",
    "preset": "painted-bloom",
    "durationMs": 2200
  },
  "motion": {
    "exit": "gate",
    "signature": [
      "sway",
      "shimmer"
    ]
  },
  "fonts": {
    "preload": [
      "fonts/script-500.woff2",
      "fonts/display-400.woff2",
      "fonts/body-400.woff2"
    ]
  },
  "photoFilters": [
    "none",
    "soft-warm",
    "bw"
  ],
  "slots": {
    "cover-bg": {
      "src": "assets/cover-bg.webp",
      "avif": "assets/cover-bg.avif",
      "width": 768,
      "height": 1376,
      "fallback": "assets/cover-bg.jpg",
      "priority": true,
      "desktop": {
        "src": "assets/cover-bg-desktop.webp",
        "avif": "assets/cover-bg-desktop.avif"
      }
    },
    "hero-bg": {
      "src": "assets/cover-bg-desktop.webp",
      "avif": "assets/cover-bg-desktop.avif",
      "width": 1376,
      "height": 768,
      "fallback": "assets/cover-bg-desktop.jpg"
    },
    "hero-top": {
      "src": "assets/hero-top.webp",
      "avif": "assets/hero-top.avif",
      "width": 768,
      "height": 323,
      "priority": true
    },
    "hero-bottom": {
      "src": "assets/hero-bottom.webp",
      "avif": "assets/hero-bottom.avif",
      "width": 768,
      "height": 571
    },
    "parallax-back": {
      "src": "assets/parallax-back.webp",
      "avif": "assets/parallax-back.avif",
      "width": 768,
      "height": 481,
      "depth": -0.1
    },
    "parallax-front": {
      "src": "assets/parallax-front.webp",
      "avif": "assets/parallax-front.avif",
      "width": 768,
      "height": 1018
    },
    "photo-ring": {
      "src": "assets/photo-ring.webp",
      "avif": "assets/photo-ring.avif",
      "width": 880,
      "height": 1092
    },
    "corner-tl": {
      "src": "assets/corner-tl.webp",
      "avif": "assets/corner-tl.avif",
      "width": 720,
      "height": 720,
      "mirror": true
    },
    "particles": {
      "frames": [
        "assets/petal-1.webp",
        "assets/petal-2.webp",
        "assets/petal-3.webp",
        "assets/petal-4.webp",
        "assets/petal-5.webp",
        "assets/petal-6.webp"
      ],
      "count": 7,
      "size": 22
    },
    "monogram-frame": {
      "component": "slots/MonogramFrame.jsx"
    },
    "heading-ornament": {
      "svg": "assets/heading.svg",
      "width": 96,
      "height": 16
    },
    "divider": {
      "svg": "assets/divider.svg",
      "width": 140,
      "height": 16
    }
  },
  "copyVariants": [
    "islam",
    "kristen",
    "katolik",
    "umum"
  ],
  "eventTypes": [
    "akad",
    "pemberkatan",
    "sakramen",
    "resepsi",
    "adat",
    "ngunduh_mantu",
    "lainnya"
  ],
  "og": {
    "template": "assets/og-template.jpg",
    "box": [
      400,
      90,
      800,
      560
    ],
    "ink": "#1e3b2c",
    "accent": "#9e2f2c",
    "shadow": false,
    "fonts": {
      "names": "fonts/script-500.woff2",
      "label": "fonts/label-600.woff2",
      "text": "fonts/body-400.woff2"
    }
  }
}
