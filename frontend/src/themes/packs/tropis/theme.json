{
  "id": "tropis",
  "layoutVariant": "painted",
  "hero": "framed",
  "gallery": "editorial",
  "opening": {
    "type": "css",
    "preset": "painted-bloom",
    "durationMs": 2200
  },
  "motion": { "exit": "curtain", "signature": ["drift", "sway"] },
  "fonts": {
    "preload": [
      "fonts/script-400.woff2",
      "fonts/display-400.woff2",
      "fonts/body-400.woff2"
    ]
  },
  "photoFilters": [
    "none",
    "soft-warm",
    "bw"
  ],
  "slots": {
    "cover-bg": {
      "src": "assets/cover-bg.webp",
      "avif": "assets/cover-bg.avif",
      "fallback": "assets/cover-bg.jpg",
      "width": 1080,
      "height": 1935,
      "priority": true,
      "desktop": {
        "src": "assets/cover-bg-desktop.webp",
        "avif": "assets/cover-bg-desktop.avif"
      }
    },
    "hero-bg": {
      "src": "assets/cover-bg-desktop.webp",
      "avif": "assets/cover-bg-desktop.avif",
      "fallback": "assets/cover-bg-desktop.jpg",
      "width": 1920,
      "height": 1072
    },
    "hero-top": {
      "src": "assets/hero-top.webp",
      "avif": "assets/hero-top.avif",
      "width": 1080,
      "height": 832,
      "priority": true
    },
    "hero-bottom": {
      "src": "assets/hero-bottom.webp",
      "avif": "assets/hero-bottom.avif",
      "width": 1080,
      "height": 658
    },
    "parallax-back": {
      "src": "assets/parallax-back.webp",
      "avif": "assets/parallax-back.avif",
      "width": 1080,
      "height": 425,
      "depth": -0.1
    },
    "parallax-front": {
      "src": "assets/parallax-front.webp",
      "avif": "assets/parallax-front.avif",
      "width": 1080,
      "height": 813
    },
    "photo-ring": {
      "src": "assets/photo-ring.webp",
      "avif": "assets/photo-ring.avif",
      "width": 880,
      "height": 1092
    },
    "corner-tl": {
      "src": "assets/corner-tl.webp",
      "avif": "assets/corner-tl.avif",
      "width": 720,
      "height": 720,
      "mirror": true
    },
    "particles": {
      "frames": [
        "assets/petal-1.webp",
        "assets/petal-2.webp",
        "assets/petal-3.webp",
        "assets/petal-4.webp",
        "assets/petal-5.webp",
        "assets/petal-6.webp"
      ],
      "count": 7,
      "size": 22
    },
    "monogram-frame": {
      "component": "slots/MonogramFrame.jsx"
    },
    "heading-ornament": {
      "svg": "assets/heading.svg",
      "width": 96,
      "height": 16
    },
    "divider": {
      "svg": "assets/divider.svg",
      "width": 140,
      "height": 16
    },
    "section-edge": {
      "src": "assets/section-edge.webp",
      "avif": "assets/section-edge.avif",
      "width": 400,
      "height": 1024
    },
    "section-garland": {
      "src": "assets/section-garland.webp",
      "avif": "assets/section-garland.avif",
      "width": 1024,
      "height": 321
    },
    "monogram-wreath": {
      "src": "assets/monogram-wreath.webp",
      "avif": "assets/monogram-wreath.avif",
      "width": 640,
      "height": 640
    },
    "card-corner": {
      "src": "assets/card-corner.webp",
      "avif": "assets/card-corner.avif",
      "width": 360,
      "height": 360
    }
  },
  "copyVariants": [
    "islam",
    "kristen",
    "katolik",
    "umum"
  ],
  "eventTypes": [
    "akad",
    "pemberkatan",
    "sakramen",
    "resepsi",
    "adat",
    "ngunduh_mantu",
    "lainnya"
  ],
  "og": {
    "template": "assets/og-template.jpg",
    "box": [
      330,
      70,
      870,
      460
    ],
    "ink": "#1f3a2c",
    "accent": "#b2452f",
    "shadow": false,
    "fonts": {
      "names": "fonts/script-400.woff2",
      "label": "fonts/display-400.woff2",
      "text": "fonts/body-400.woff2"
    }
  }
}
