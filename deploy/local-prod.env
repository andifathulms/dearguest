# Prod-like LOCAL stack only (scripts/local-prod.sh). Never use these values on
# a server: every secret here is public. Production settings, a real nginx
# build and TLS (self-signed), rclone's S3 server standing in for R2, Mailpit
# catching email.
ENV_FILE=deploy/local-prod.env
SECRET_KEY=local-prod-only-not-secret-0123456789abcdefghijklmnopqrstuvwxyz
DEBUG=False
DB_PASSWORD=local-prod-only
ALLOWED_HOSTS=localhost,backend
CSRF_TRUSTED_ORIGINS=https://localhost:8443
CORS_ALLOWED_ORIGINS=https://localhost:8443
FRONTEND_URL=https://localhost:8443
VITE_PUBLIC_ORIGIN=https://localhost:8443
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
MEDIA_ROOT=/app/media
# Absolute media URLs need the port here (in production the site is on 443).
MEDIA_URL_ORIGIN=https://localhost:8443
ADMIN_URL=kelola/
ADMIN_PATH=kelola
ADMIN_REQUIRE_OTP=True
CSP_MODE=enforce
SECURE_SSL_REDIRECT=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=DearGuest <no-reply@localhost>
ADMIN_EMAIL=ops@localhost
HEALTH_TOKEN=local-prod-health-token
# Backups to the local S3 stand-in. The matching age identity is NOT in the
# repo; for a drill pass it to scripts/backup/restore-drill.sh.
BACKUP_AGE_RECIPIENT=age175ap6x335rr9rsytpm2ke4yas34skcw2xdj5kdc6jp9zqqluegvq4xlnzr
BACKUP_REMOTE=r2:dearguest-backups
BACKUP_CREATE_BUCKET=1
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Other
RCLONE_CONFIG_R2_ENDPOINT=http://s3:9000
RCLONE_CONFIG_R2_ACCESS_KEY_ID=local-prod
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=local-prod-only
