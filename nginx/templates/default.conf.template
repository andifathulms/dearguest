# Edge nginx for production. Rendered at container start by the nginx image's
# envsubst step; only ${DOMAIN}, ${MEDIA_DOMAIN}, ${ADMIN_PATH}, ${CSP_MODE}
# and ${HSTS_SECONDS} are substituted (NGINX_ENVSUBST_FILTER), so nginx's own
# $variables are left alone.

# Compress text responses (JS, CSS, JSON, SVG): roughly 3x smaller on mobile data.
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 6;
gzip_proxied any;
gzip_types text/css application/javascript application/json image/svg+xml text/plain;

# Uploads that aren't an allowed image/audio type are downloaded, never rendered.
map $uri $media_disposition {
    default                                   "attachment";
    "~*\.(jpe?g|png|webp|mp3|m4a|aac|ogg)$"   "";
}

# Link-preview crawlers ($og_crawler, generated from shared/crawlers.txt by
# scripts/sync_themes.py) asking for an invitation link get Django's tag page;
# people get the SPA.
include /etc/nginx/snippets/og-crawlers.conf;
map $uri $invitation_path {
    default                                   0;
    "~^/[-\w]+(/[A-Za-z0-9]{4,12})?/?$"       1;
}
map "$og_crawler$invitation_path" $og_proxy {
    default 0;
    "11"    1;
}

# Search engines may index the marketing site only. Everything else served
# here (invitations, dashboard) says noindex; an empty value sends no header.
map $request_uri $robots_tag {
    default                                                     "noindex, nofollow";
    "~^/(\?.*)?$"                                                "";
    "~^/tema(/[a-z0-9-]+)?/?(\?.*)?$"                            "";
    "~^/(register|robots\.txt|sitemap\.xml)"                    "";
    "~^/(assets|social|theme-previews)/"                         "";
}

# HTML (the shell and the prerendered marketing pages) must be revalidated, or
# a deploy leaves visitors on stale chunk hashes.
map $uri $html_cache {
    default            "";
    "~\.html$"         "no-cache";
}

# Content Security Policy for the SPA. Sources: pack fonts and art are
# same-origin; Google Fonts (index.html); uploads on MEDIA_DOMAIN; Google Maps
# and YouTube embeds (MapsSection, LiveStreamSection); Sentry ingest.
# Phase 3: add the payment provider's script/frame/connect origins here.
map $host $csp_policy {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://${MEDIA_DOMAIN}; media-src 'self' blob: https://${MEDIA_DOMAIN}; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report/";
}
map "${CSP_MODE}" $csp_enforce {
    default    "";
    enforce    $csp_policy;
}
map "${CSP_MODE}" $csp_report_only {
    default    $csp_policy;
    enforce    "";
}
map $host $hsts {
    default    "max-age=${HSTS_SECONDS}; includeSubDomains";
}

# Admin login: at most 5 attempts a minute per client (Django adds its own
# per-account lockout and TOTP).
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/m;

# Access log: JSON, one line per request, with the request id Django also logs.
# No query strings (?to= carries guests' names) and guest codes masked.
map $uri $log_uri {
    default                                                          $uri;
    "~^(?<lead>/(?!(?:api|dashboard|tema|assets|static|media|social|theme-previews)/)[-\w]+/)[A-Za-z0-9]{6,12}/?$"   "${lead}[kode]";
    "~^(?<lead>/og/[-\w]+/)[A-Za-z0-9]{4,12}(?<tail>/[0-9a-f]{16}\.jpg)$"   "${lead}[kode]${tail}";
}
log_format json escape=json '{"time":"$time_iso8601","request_id":"$request_id","method":"$request_method",'
    '"path":"$log_uri","status":$status,"bytes":$body_bytes_sent,"duration":$request_time,'
    '"upstream":"$upstream_response_time","crawler":"$og_crawler","ua_mobile":"$http_sec_ch_ua_mobile"}';
access_log /dev/stdout json;

# Port 80: Let's Encrypt HTTP-01 challenges only; everything else goes to HTTPS.
server {
    listen 80 default_server;
    server_name ${DOMAIN} ${MEDIA_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Optional separate origin for user uploads (MEDIA_URL_ORIGIN on the backend).
# With MEDIA_DOMAIN unset this server_name is "media.invalid" and never matches.
server {
    listen 443 ssl;
    http2 on;
    server_name ${MEDIA_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/media.conf;

    location / {
        return 404;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    client_max_body_size 20M;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
    }

    # Django admin, at a path of its own (ADMIN_PATH / ADMIN_URL).
    location /${ADMIN_PATH}/ {
        include /etc/nginx/snippets/proxy.conf;
    }
    location = /${ADMIN_PATH}/login/ {
        limit_req zone=admin_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Per-invitation share pages (Open Graph link previews)
    location /share/ {
        include /etc/nginx/snippets/proxy.conf;
    }

    # Link-preview images, rendered by Django; content-hashed URLs, so Django
    # sends an immutable Cache-Control.
    location /og/ {
        include /etc/nginx/snippets/proxy.conf;
    }

    # Django admin static files (collectstatic)
    location /static/ {
        alias /app/staticfiles/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    include /etc/nginx/snippets/media.conf;

    root /usr/share/nginx/html;

    # Vite output: content-hashed filenames, safe to cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The SPA shell must never be cached, or a deploy leaves guests on stale chunk hashes.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $robots_tag;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Client-side routes (/:slug, /dashboard/...) fall back to the SPA shell;
    # prerendered pages (dist/<path>/index.html) are served as they are.
    location / {
        try_files $uri $uri/index.html @spa;
        add_header Cache-Control $html_cache;
        add_header X-Robots-Tag $robots_tag;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location @spa {
        error_page 418 = @og;
        if ($og_proxy) {
            return 418;
        }
        rewrite ^ /index.html last;
    }

    location @og {
        include /etc/nginx/snippets/proxy.conf;
    }
}
