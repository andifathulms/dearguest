SECRET_KEY=your-secret-key-here
DEBUG=True
DATABASE_URL=postgres://undangan_user:undangan_pass@db:5432/undangan_db
DB_NAME=undangan_db
DB_USER=undangan_user
DB_PASSWORD=undangan_pass
DB_HOST=db
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
MEDIA_ROOT=/app/media
# Optional: serve user uploads from a separate origin, e.g. https://media.yourdomain.com
# (no trailing slash). Point that host at the same nginx. Unset = same origin as the app.
MEDIA_URL_ORIGIN=
ADMIN_WHATSAPP_NUMBER=628123456789

# Shared cache for rate limiting. Set by both compose files to the bundled
# redis service; only override if you run Redis elsewhere. Required in production.
# REDIS_URL=redis://redis:6379/0
# Trust nginx's X-Real-IP for the client IP. Forced on in production settings;
# leave unset in dev, where Django is reached directly.
# TRUST_PROXY_HEADERS=False

# Public URL of the frontend (used in password-reset emails & share links)
FRONTEND_URL=http://localhost:5173
# Same public origin, baked into the frontend build for every link a guest
# receives (WhatsApp share, per-guest links, QR codes). Required for
# `vite build`/production; no trailing slash. Normally equal to FRONTEND_URL.
VITE_PUBLIC_ORIGIN=http://localhost:5173

# Email — console backend prints to logs in dev. For production set SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Undangan Digital <noreply@undangan.local>
ADMIN_EMAIL=admin@undangan.local

# Production-only HTTPS / CSRF (comma-separated, e.g. https://undangan.com)
CSRF_TRUSTED_ORIGINS=
# Session cookies (httpOnly JWTs) are Secure unless DEBUG; override only for a
# plain-http local prod-like stack.
# AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. Starts at 1 hour; raise only after HTTPS is verified.
# SECURE_HSTS_SECONDS=3600

# ---- Production edge (docker-compose.prod.yml) ----
# Public domain served by nginx; must also be in ALLOWED_HOSTS.
DOMAIN=
# Optional media host (must match MEDIA_URL_ORIGIN, and be on the same certificate).
# MEDIA_DOMAIN=
# Email Let's Encrypt uses for expiry notices (used in the certbot command).
LETSENCRYPT_EMAIL=
# Certificate files as seen inside the nginx container. Default: the Let's
# Encrypt live files for $DOMAIN. For your own certs, put them in nginx/certs/
# and use /etc/nginx/certs/fullchain.pem and /etc/nginx/certs/privkey.pem.
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# Host ports (default 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Admin (Phase 5) -------------------------------------------------------
# Django admin path (Django) and the same path for nginx; not "admin".
ADMIN_URL=kelola-XXXX/
ADMIN_PATH=kelola-XXXX
# Staff need a TOTP code (python manage.py enrol_totp <user>). On unless DEBUG.
# ADMIN_REQUIRE_OTP=True

# --- nginx (Phase 5) -------------------------------------------------------
# enforce | report-only. Report-only lets a blocked resource load while you
# investigate (violations still reach /api/csp-report/).
CSP_MODE=enforce

# --- gunicorn (Phase 5) ----------------------------------------------------
# Defaults: 2 x CPU + 1 workers, 4 threads each (backend/gunicorn.conf.py).
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4

# --- Ops (Phase 5) ---------------------------------------------------------
# The git SHA being run; scripts/deploy.sh sets it (Sentry release, /api/health/).
# RELEASE=
# Where the images come from. Unset: deploy.sh builds them on this server.
# Set: deploy.sh pulls the ones CI pushed for the commit (RUNBOOK.md §1); run
# `docker login ghcr.io` once with a token that has read:packages.
# IMAGE_PREFIX=ghcr.io/andifathulms/dearguest
# Deep health check token (UptimeRobot: /api/health/?deep=1 with X-Health-Token).
HEALTH_TOKEN=
# Error tracking (Sentry). Backend DSN; frontend DSN (public, baked into the
# build); org/project and a token file for uploading source maps at build time.
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=
# SENTRY_AUTH_TOKEN_FILE=/root/secrets/sentry-auth-token
# Alerts from scheduled jobs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Retention: guest data deleted this many days after an invitation expires.
RETENTION_DAYS=90

# --- Backups (Phase 5) -----------------------------------------------------
# age PUBLIC key; the private identity is kept offline (RUNBOOK.md).
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=r2:dearguest-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
